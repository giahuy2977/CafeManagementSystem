<Window x:Class="CafeManagementSystem.Views.OwnerMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cafe Management System - Phân Hệ Điều Hành &amp; Quản Trị (Chủ Quán)" 
        Height="760" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Be Vietnam Pro, Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================ -->
        <!-- CỘT 0: SIDEBAR QUẢN TRỊ DÀNH CHO CHỦ QUÁN        -->
        <!-- ================================================ -->
        <Border Grid.Column="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề logo Sidebar -->
                <StackPanel Grid.Row="0" Margin="0, 24, 0, 28" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#x2615;" 
                                   FontFamily="Segoe UI Symbol" 
                                   FontSize="24" 
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="CAFE POS"
                                   Foreground="{StaticResource TextOnDarkBrush}"
                                   FontSize="22"
                                   FontWeight="ExtraBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="CHỦ QUÁN / QUẢN LÝ"
                               Foreground="{StaticResource TintBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Bộ 5 nút chức năng cho Chủ quán -->
                <StackPanel Grid.Row="1">
                    <!-- Nút 1: Tổng quan Dashboard -->
                    <RadioButton x:Name="NavDashboardBtn"
                                 GroupName="OwnerNavigation"
                                 IsChecked="{Binding IsDashboardSelected, Mode=TwoWay}"
                                 Command="{Binding NavigateDashboardCommand}"
                                 Tag="Dashboard"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tổng quan (Dashboard)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nút 2: Quản lý Thực đơn (Giá bán & Giá vốn) -->
                    <RadioButton x:Name="NavMenuBtn"
                                 GroupName="OwnerNavigation"
                                 IsChecked="{Binding IsMenuSelected, Mode=TwoWay}"
                                 Command="{Binding NavigateMenuCommand}"
                                 Tag="Menu"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC32;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Quản lý Thực đơn" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nút 3: Lịch sử Hóa đơn -->
                    <RadioButton x:Name="NavInvoicesBtn"
                                 GroupName="OwnerNavigation"
                                 IsChecked="{Binding IsInvoicesSelected, Mode=TwoWay}"
                                 Command="{Binding NavigateInvoicesCommand}"
                                 Tag="Invoices"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tra cứu Hóa đơn" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nút 4: Quản lý Nhân sự -->
                    <RadioButton x:Name="NavStaffBtn"
                                 GroupName="OwnerNavigation"
                                 IsChecked="{Binding IsStaffSelected, Mode=TwoWay}"
                                 Command="{Binding NavigateStaffCommand}"
                                 Tag="Staff"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Quản lý Nhân sự" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nút 5: Ca làm việc & Chấm công -->
                    <RadioButton x:Name="NavShiftsBtn"
                                 GroupName="OwnerNavigation"
                                 IsChecked="{Binding IsShiftsSelected, Mode=TwoWay}"
                                 Command="{Binding NavigateShiftsCommand}"
                                 Tag="Shifts"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ca làm &amp; Chấm công" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Cụm dưới đáy: Cài đặt và Tên Chủ quán -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <RadioButton x:Name="NavSettingsBtn"
                                 GroupName="OwnerNavigation"
                                 IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}"
                                 Command="{Binding NavigateSettingsCommand}"
                                 Tag="Settings"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cài đặt hệ thống" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Đường kẻ phân cách -->
                    <Border Height="1" Background="{StaticResource SecondaryBrush}" Opacity="0.5" Margin="16,8,16,12"/>

                    <!-- Tên chủ quán & Nút đăng xuất -->
                    <Grid Margin="16,0,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextOnDarkBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OwnerNameDisplay" 
                                       Text="{Binding DisplayName, FallbackValue='Trần Chủ Quán'}" 
                                       FontSize="13" 
                                       Foreground="{StaticResource TextOnDarkBrush}" 
                                       VerticalAlignment="Center" 
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" 
                                Command="{Binding LogoutCommand}"
                                ToolTip="Đăng xuất" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Padding="4">
                            <TextBlock Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource StatusErrBgBrush}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================ -->
        <!-- CỘT 1: VÙNG NỘI DUNG HIỂN THỊ CÁC MÀN HÌNH CON   -->
        <!-- ================================================ -->
        <ContentControl x:Name="OwnerContentArea" 
                        Grid.Column="1" 
                        Margin="0"
                        Content="{Binding CurrentView}"/>
    </Grid>
</Window>
