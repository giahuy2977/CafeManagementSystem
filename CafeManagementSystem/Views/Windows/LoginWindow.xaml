<Window x:Class="CafeManagementSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CafeManagementSystem.Views"
        mc:Ignorable="d"
        Title="Cafe Login" Height="470" Width="420"
        Background="{StaticResource SurfaceCardBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Be Vietnam Pro, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <!-- Header -->
            <RowDefinition Height="*"></RowDefinition>
            <!-- Username & Password -->
        </Grid.RowDefinitions>

        <!-- ============================================= -->
        <!-- ROW 0 : TIÊU ĐỀ -->
        <!-- ============================================= -->

        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                CornerRadius="0"
                BorderThickness="0"
                Padding="10">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock Text="&#x2615;" 
                           FontFamily="Segoe UI Symbol" 
                           FontSize="32" 
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0, 0, 10, 10"></TextBlock>

                <TextBlock Text="ĐĂNG NHẬP"
                           Foreground="{StaticResource TextOnDarkBrush}"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"></TextBlock>
            </WrapPanel>
        </Border>

        <!-- ============================================= -->
        <!-- ROW 1 : USERNAME, PASSWORD, BUTTON -->
        <!-- ============================================= -->

        <StackPanel Grid.Row="1" Margin="36,24,36,24">

            <!-- 1. Trường Username -->
            <TextBlock Text="Username"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <TextBox x:Name="UsernameTextBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FlatTextBoxStyle}" 
                         Margin="0, 0, 0, 16"/>

            <!-- 2. Trường Password -->
            <TextBlock Text="Password"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <Border Height="40"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource BorderBrushDefault}"
                    BorderThickness="1"
                    CornerRadius="8">
                <!-- PasswordBox (Hiển thị mặc định ẩn mật khẩu) -->
                <PasswordBox x:Name="UserPasswordBox"
                                 FontSize="14"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"/>
            </Border>

            <!-- 3. Dòng thông báo lỗi (Invalid username or password...) -->
            <TextBlock Text="{Binding ErrorMessage, FallbackValue='Tài khoản hoặc mật khẩu chưa đúng. Vui lòng thử lại.'}"
                       FontSize="12"
                       Foreground="{StaticResource StatusErrBrush}"
                       Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 4. Nút Login (IsDefault="True" giúp nhấn phím Enter là đăng nhập ngay) -->
            <Button Content="Login"
                    Command="{Binding LoginCommand}"
                    IsDefault="True"
                    Style="{StaticResource LoginActionButtonStyle}"
                    Margin="0,20,0,16" />

            <!-- 5. Nút Forgot Password? -->
            <Button Content="Forgot Password?"
                    Command="{Binding ForgotPasswordCommand}"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="linkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="linkText" Property="TextDecorations" Value="Underline" />
                                <Setter TargetName="linkText" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

    </Grid>
</Window>
