<UserControl x:Class="CafeManagementSystem.Views.UserControls.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="Be Vietnam Pro, Segoe UI">

    <Grid Margin="0,10,0,0">
        <!-- Khai báo Style cục bộ để hiển thị ngay mà không lo lỗi thiếu StaticResource -->
        <Grid.Resources>
            <Style x:Key="LocalCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderBrush" Value="#EAE3DD"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <Style x:Key="LocalTextBoxStyle" TargetType="TextBox">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="#FCFAF8"/>
                <Setter Property="BorderBrush" Value="#DCD4CE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Menu Management" FontSize="26" FontWeight="Bold" Foreground="#2C221E"/>
            <TextBlock Text="Home  /  Menu" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="#7D706B" FontSize="13"/>
        </Grid>

        <!-- Nội dung chính 2 cột -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: BẢNG DANH SÁCH SẢN PHẨM -->
            <Border Grid.Column="0" Style="{StaticResource LocalCardStyle}" Margin="0,0,18,0">
                <DockPanel>
                    <!-- Thanh tìm kiếm & Lọc -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMenuSearch" Style="{StaticResource LocalTextBoxStyle}"
                                 TextChanged="MenuFilter_Changed" Margin="0,0,12,0"/>
                        <ComboBox x:Name="CmbMenuFilterCategory" Grid.Column="1" SelectedIndex="0"
                                  SelectionChanged="MenuFilter_Changed" Padding="10,7">
                            <ComboBoxItem Content="All Categories"/>
                            <ComboBoxItem Content="Coffee"/>
                            <ComboBoxItem Content="Tea"/>
                            <ComboBoxItem Content="Bakery"/>
                            <ComboBoxItem Content="Snacks"/>
                        </ComboBox>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid x:Name="MenuDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="MenuDataGrid_SelectionChanged"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0EAE5"
                              BorderThickness="0" Background="White" RowHeight="46" HeadersVisibility="Column"
                              CanUserAddRows="False" FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#2C221E"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="BorderBrush" Value="#EAE3DD"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='${0:F2}'}" Width="90"/>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left"
                                                Background="#D7F5DD" BorderBrush="#88D498" BorderThickness="1">
                                            <TextBlock x:Name="BadgeTxt" Text="{Binding StatusText}" Foreground="#1E6F31"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter TargetName="Badge" Property="Background" Value="#FADBD8"/>
                                                <Setter TargetName="Badge" Property="BorderBrush" Value="#E69A94"/>
                                                <Setter TargetName="BadgeTxt" Property="Foreground" Value="#922B21"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- CỘT PHẢI: FORM CHI TIẾT SẢN PHẨM -->
            <Border Grid.Column="1" Style="{StaticResource LocalCardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Product Details" FontSize="20" FontWeight="Bold"
                               Foreground="#2C221E" Margin="0,0,0,18"/>

                    <TextBlock Text="Product Name" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditName" Style="{StaticResource LocalTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbEditCategory" SelectedIndex="0" Padding="10,8" Margin="0,0,0,14">
                        <ComboBoxItem Content="Coffee"/>
                        <ComboBoxItem Content="Tea"/>
                        <ComboBoxItem Content="Bakery"/>
                        <ComboBoxItem Content="Snacks"/>
                    </ComboBox>

                    <TextBlock Text="Price ($)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditPrice" Style="{StaticResource LocalTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkEditAvailable" Content="Is Available" IsChecked="True"
                              FontSize="13" Margin="0,0,0,24"/>

                    <!-- 3 Nút Hành Động -->
                    <UniformGrid Columns="3">
                        <Button Content="Save" Background="#C38154"
                                Style="{StaticResource LocalButtonStyle}" Margin="0,0,6,0" Click="BtnSaveProduct_Click"/>
                        <Button Content="Clear" Background="#EAEAEA" Foreground="#2C221E"
                                Style="{StaticResource LocalButtonStyle}" Margin="3,0" Click="BtnClearForm_Click"/>
                        <Button Content="Delete" Background="#D44040"
                                Style="{StaticResource LocalButtonStyle}" Margin="6,0,0,0" Click="BtnDeleteProduct_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
