<UserControl x:Class="CafeManagementSystem.Views.UserControls.OwnerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1100"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="Be Vietnam Pro, Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề + Bộ lọc ngày -->
            <RowDefinition Height="Auto"/>
            <!-- 5 Thẻ KPI -->
            <RowDefinition Height="*"/>
            <!-- Bảng Top Món + Nhân sự trực ca -->
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- ROW 0: TIÊU ĐỀ & THANH LỌC THỜI GIAN                             -->
        <!-- ================================================================ -->
        <Border Grid.Row="0"
                Style="{StaticResource FlatCardBorderStyle}"
                Margin="0,0,0,16"
                Padding="16,12">
            <DockPanel>
                <!-- Tiêu đề bên trái -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tổng Quan Hoạt Động &amp; Báo Cáo Kinh Doanh"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Cập nhật tự động số liệu bán hàng, lợi nhuận ước tính và tình trạng phục vụ"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Bộ lọc bên phải -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Từ ngày -->
                    <TextBlock Text="Từ ngày:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpFromDate" Width="130" Height="36" Style="{StaticResource ModernDatePicker}" Margin="0,0,12,0"/>

                    <!-- Đến ngày -->
                    <TextBlock Text="Đến ngày:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpToDate" Width="130" Height="36" Style="{StaticResource ModernDatePicker}" Margin="0,0,12,0"/>

                    <!-- Cụm nút nhanh -->
                    <Button Content="Hôm nay" Width="80" Height="36" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Tháng này" Width="85" Height="36" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Lọc dữ liệu" Width="95" Height="36" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================ -->
        <!-- ROW 1: HÀNG 5 THẺ KPI PHẲNG                                      -->
        <!-- ================================================================ -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">

            <!-- KPI 1: TỔNG DOANH THU -->
            <Border Style="{StaticResource FlatCardBorderStyle}" Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Tổng Doanh Thu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource IconTodayRevenue}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtTotalRevenue" Text="15.850.000đ" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="+12.5% so với kỳ trước" FontSize="11" Foreground="{StaticResource StatusOkBrush}"/>
                </StackPanel>
            </Border>

            <!-- KPI 2: LỢI NHUẬN ƯỚC TÍNH (D15) -->
            <Border Style="{StaticResource FlatCardBorderStyle}" Margin="4,0,4,0" Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Lợi Nhuận Ước Tính" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource IconPeriodRevenue}" Fill="{StaticResource StatusOkBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtEstimatedProfit" Text="9.420.000đ" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource StatusOkBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Doanh thu - Giá vốn món" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- KPI 3: SỐ ĐƠN HOÀN THÀNH -->
            <Border Style="{StaticResource FlatCardBorderStyle}" Margin="4,0,4,0" Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Đơn Đã Thanh Toán" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource IconCompletedOrders}" Fill="{StaticResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtCompletedOrders" Text="142 đơn" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="100% đơn hợp lệ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- KPI 4: GIÁ TRỊ TRUNG BÌNH ĐƠN (AOV) -->
            <Border Style="{StaticResource FlatCardBorderStyle}" Margin="4,0,4,0" Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Giá Trị TB / Đơn" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource IconMiniChart}" Fill="{StaticResource SecondaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtAverageOrderValue" Text="111.600đ" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Trung bình mỗi khách" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- KPI 5: SỐ BÀN ĐANG PHỤC VỤ (D1) -->
            <Border Style="{StaticResource FlatCardBorderStyle}" Margin="8,0,0,0" Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Bàn Đang Có Khách" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtOccupiedTables" Text="5" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text=" / 12 bàn" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="41.6% công suất quán" FontSize="11" Foreground="{StaticResource StatusWarnBrush}"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- ================================================================ -->
        <!-- ROW 2: BẢNG TOP MÓN BÁN CHẠY (6.5*) + NHÂN SỰ TRỰC CA (3.5*)      -->
        <!-- ================================================================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- BẢNG TOP SẢN PHẨM BÁN CHẠY -->
            <Border Grid.Column="0"
                    Style="{StaticResource FlatCardBorderStyle}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Top Món Bán Chạy &amp; Hiệu Quả Lợi Nhuận"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="DgTopSellingProducts"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource FlatDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank, StringFormat='{}{0}.'}" Width="44"/>
                            <DataGridTextColumn Header="Tên Món" Binding="{Binding ProductName}" Width="2.2*"/>
                            <DataGridTextColumn Header="SL Bán" Binding="{Binding TotalQuantitySold, StringFormat='{}{0:N0} ly'}" HeaderStyle="{StaticResource CenterColumnHeaderStyle}" ElementStyle="{StaticResource CenterCellTextStyle}" Width="1*"/>
                            <DataGridTextColumn Header="Doanh Thu" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0}đ'}" HeaderStyle="{StaticResource RightColumnHeaderStyle}" ElementStyle="{StaticResource RightCellTextStyle}" Width="1.4*"/>
                            <DataGridTextColumn Header="Giá Vốn" Binding="{Binding TotalCost, StringFormat='{}{0:N0}đ'}" HeaderStyle="{StaticResource RightColumnHeaderStyle}" ElementStyle="{StaticResource RightCellTextStyle}" Width="1.2*"/>
                            <DataGridTextColumn Header="Lợi Nhuận" Binding="{Binding Profit, StringFormat='{}{0:N0}đ'}" HeaderStyle="{StaticResource RightColumnHeaderStyle}" ElementStyle="{StaticResource RightCellTextStyle}" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- BẢNG NHÂN SỰ ĐANG TRỰC CA HÔM NAY -->
            <Border Grid.Column="2"
                    Style="{StaticResource FlatCardBorderStyle}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Nhân Sự Đang Trong Ca"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1"
                              x:Name="DgStaffOnDuty"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource FlatDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhân Viên" Binding="{Binding StaffName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Ca Trực" Binding="{Binding ShiftName}" Width="1*"/>
                            <DataGridTextColumn Header="Vào Ca" Binding="{Binding CheckInTime}" Width="1*"/>
                            <DataGridTemplateColumn Header="Trạng Thái" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource StatusOkBgBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusOkBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
