<UserControl x:Class="CafeManagementSystem.Views.UserControls.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1060"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="Be Vietnam Pro, Segoe UI">

    <Grid Margin="0,10,0,0">
        <Grid.Resources>
            <Style x:Key="SalesCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderBrush" Value="#EAE3DD"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="SalesTextBoxStyle" TargetType="TextBox">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="#FCFAF8"/>
                <Setter Property="BorderBrush" Value="#DCD4CE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CategoryPillStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="#F3EFEA"/>
                <Setter Property="Foreground" Value="#2C221E"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="#4A3B35"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PayButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#C38154"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Sales / New Order" FontSize="24" FontWeight="Bold" Foreground="#2C221E"/>
            <TextBlock x:Name="TxtClock" Text="Mon 12/23, 12:04 PM" FontSize="13" Foreground="#7D706B" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 3 Cột Chính -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT 1: DANH SÁCH BÀN -->
            <Border Grid.Column="0" Style="{StaticResource SalesCardStyle}" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tables" FontSize="17" FontWeight="Bold"
                               Foreground="#2C221E" Margin="0,0,0,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TablesListControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="4" Height="86" Cursor="Hand" Click="TableTile_Click" Tag="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="TileBorder" CornerRadius="10" Padding="6" Background="#467344">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SeatsText}" Foreground="#E2ECE1" FontSize="11" HorizontalAlignment="Center" Margin="0,2"/>
                                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                        <Setter TargetName="TileBorder" Property="Background" Value="#3B322E"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- CỘT 2: THỰC ĐƠN CHỌN MÓN -->
            <Border Grid.Column="1" Style="{StaticResource SalesCardStyle}" Margin="0,0,14,0">
                <DockPanel>
                    <TextBox x:Name="TxtSalesSearch" DockPanel.Dock="Top" Style="{StaticResource SalesTextBoxStyle}"
                             TextChanged="SalesFilter_Changed" Margin="0,0,0,12"/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="All" IsChecked="True" Checked="CategoryPill_Checked" Style="{StaticResource CategoryPillStyle}"/>
                        <RadioButton Content="Coffee" Checked="CategoryPill_Checked" Style="{StaticResource CategoryPillStyle}"/>
                        <RadioButton Content="Tea" Checked="CategoryPill_Checked" Style="{StaticResource CategoryPillStyle}"/>
                        <RadioButton Content="Bakery" Checked="CategoryPill_Checked" Style="{StaticResource CategoryPillStyle}"/>
                        <RadioButton Content="Snacks" Checked="CategoryPill_Checked" Style="{StaticResource CategoryPillStyle}"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SalesProductsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" Background="#FCF9F7" BorderBrush="#EAE3DD"
                                            BorderThickness="1" CornerRadius="10" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Icon}" FontSize="34" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="#2C221E" TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Price, StringFormat='${0:F2}'}" VerticalAlignment="Center"
                                                           Foreground="#7D706B" FontWeight="SemiBold"/>
                                                <Button Content="+" HorizontalAlignment="Right" Width="26" Height="26"
                                                        Background="#EFEAE6" Foreground="#2C221E"
                                                        FontWeight="Bold" Cursor="Hand" Click="AddProductToOrder_Click" Tag="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- CỘT 3: CHI TIẾT HÓA ĐƠN BÀN ĐANG CHỌN -->
            <Border Grid.Column="2" Style="{StaticResource SalesCardStyle}">
                <DockPanel>
                    <TextBlock x:Name="TxtOrderHeader" DockPanel.Dock="Top" Text="Order - Table 02 (Occupied)"
                               FontSize="16" FontWeight="Bold" Foreground="#2C221E" Margin="0,0,0,14"/>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Background="#EAE3DD" Margin="0,8,0,12"/>
                        <Grid Margin="0,3">
                            <TextBlock Text="Subtotal:" Foreground="#7D706B"/>
                            <TextBlock x:Name="TxtSubtotal" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Tax (8%):" Foreground="#7D706B"/>
                            <TextBlock x:Name="TxtTax" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock x:Name="TxtDiscount" Text="Discount: $0.00" Foreground="#7D706B"/>
                            <TextBlock Text="Apply Code" HorizontalAlignment="Right" TextDecorations="Underline"
                                       Foreground="#2C221E" Cursor="Hand" MouseLeftButtonUp="ApplyCode_Click"/>
                        </Grid>
                        <Grid Margin="0,12,0,14">
                            <TextBlock Text="Total:" FontSize="18" FontWeight="Bold" Foreground="#2C221E"/>
                            <TextBlock x:Name="TxtTotal" Text="$0.00" FontSize="19" FontWeight="Bold"
                                       HorizontalAlignment="Right" Foreground="#2C221E"/>
                        </Grid>
                        <Button Content="PAY NOW / PRINT RECEIPT   🧾" Height="46"
                                Style="{StaticResource PayButtonStyle}" Click="PayNow_Click"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OrderItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Quantity, StringFormat='{}{0}x'}"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-" Width="24" Height="24" Click="DecreaseQty_Click" Tag="{Binding}" Margin="2,0"/>
                                            <Button Content="+" Width="24" Height="24" Click="IncreaseQty_Click" Tag="{Binding}" Margin="2,0"/>
                                            <Button Content="🗑" Width="26" Height="24" Background="Transparent" BorderThickness="0"
                                                    Foreground="#7D706B" Cursor="Hand"
                                                    Click="RemoveOrderItem_Click" Tag="{Binding}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
