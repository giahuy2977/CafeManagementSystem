<UserControl x:Class="CafeManagementSystem.Views.UserControls.ShiftManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="Be Vietnam Pro, Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="*"/>
            <!-- TabControl 2 Tab -->
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- ROW 0: TIÊU ĐỀ MÀN HÌNH                                          -->
        <!-- ================================================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Phân Ca Làm Việc &amp; Bảng Chấm Công (Chủ Quán)"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- ================================================================ -->
        <!-- ROW 1: TAB CONTROL 2 PHÂN HỆ                                     -->
        <!-- ================================================================ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder"
                                        Background="{StaticResource SurfaceCardBrush}"
                                        BorderBrush="{StaticResource BorderBrushDefault}"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="8,8,0,0"
                                        Margin="0,0,4,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ============================================================ -->
            <!-- TAB 1: PHÂN CA LÀM VIỆC (SCHEDULING)                         -->
            <!-- ============================================================ -->
            <TabItem Header=" Lịch Phân Ca Làm Việc ">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: DANH SÁCH CA LÀM ĐÃ PHÂN CÔNG -->
                    <Border Grid.Column="0"
                            Style="{StaticResource FlatCardBorderStyle}"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Bộ lọc tuần / ngày -->
                                <RowDefinition Height="*"/>
                                <!-- DataGrid -->
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBlock Text="Ngày xem:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker x:Name="DpShiftFilterDate" Width="130" Height="34" Style="{StaticResource ModernDatePicker}" Margin="0,0,8,0"/>
                                    <Button Content="Lọc ca" Width="80" Height="34" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>

                                <TextBlock Text="Lịch Phân Công Ca Trong Tuần"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <DataGrid Grid.Row="1"
                                      x:Name="DgShifts"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      Style="{StaticResource FlatDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding ShiftDate}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Tên Ca" Binding="{Binding ShiftName}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Bắt Đầu" Binding="{Binding StartTime}" HeaderStyle="{StaticResource CenterColumnHeaderStyle}" ElementStyle="{StaticResource CenterCellTextStyle}" Width="1*"/>
                                    <DataGridTextColumn Header="Kết Thúc" Binding="{Binding EndTime}" HeaderStyle="{StaticResource CenterColumnHeaderStyle}" ElementStyle="{StaticResource CenterCellTextStyle}" Width="1*"/>
                                    <DataGridTextColumn Header="Nhân Viên Trực" Binding="{Binding StaffName}" Width="1.8*"/>
                                    <DataGridTemplateColumn Header="Trạng Thái" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBgBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusFgBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- CỘT PHẢI: INLINE FORM TẠO / SỬA CA LÀM -->
                    <Border Grid.Column="2"
                            Style="{StaticResource FlatCardBorderStyle}"
                            Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="THIẾT LẬP CA LÀM VIỆC"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,0,14"/>

                                <!-- Chọn nhân viên -->
                                <TextBlock Text="Nhân viên phụ trách (*)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FormShiftStaffCmb" Height="36" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Nguyễn Thu Ngân (Thu ngân)"/>
                                    <ComboBoxItem Content="Lê Pha Chế (Pha chế)"/>
                                    <ComboBoxItem Content="Phạm Phục Vụ (Phục vụ)"/>
                                </ComboBox>

                                <!-- Chọn ngày -->
                                <TextBlock Text="Ngày làm việc (*)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="FormShiftDate" Height="36" Style="{StaticResource ModernDatePicker}" Margin="0,0,0,10"/>

                                <!-- Mẫu ca -->
                                <TextBlock Text="Loại ca làm việc (*)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FormShiftTypeCmb" Height="36" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Ca Sáng (07:00 - 15:00)"/>
                                    <ComboBoxItem Content="Ca Chiều (15:00 - 23:00)"/>
                                    <ComboBoxItem Content="Ca Tối (18:00 - 23:00)"/>
                                    <ComboBoxItem Content="Ca Tùy chỉnh (Part-time)"/>
                                </ComboBox>

                                <!-- Giờ bắt đầu & kết thúc -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Giờ bắt đầu" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FormShiftStart" Text="07:00" Height="36" Style="{StaticResource FlatTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Giờ kết thúc" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FormShiftEnd" Text="15:00" Height="36" Style="{StaticResource FlatTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Ghi chú -->
                                <TextBlock Text="Ghi chú phân ca" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="FormShiftNote" Height="36" Style="{StaticResource FlatTextBoxStyle}" Margin="0,0,0,16"/>

                                <!-- Nút thao tác -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Thêm ca làm" Height="38" Style="{StaticResource PrimaryButtonStyle}"/>
                                    <Button Grid.Column="2" Content="Lưu cập nhật" Height="38" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Hủy / Xóa ca" Height="38" Style="{StaticResource DangerButtonStyle}"/>
                                    <Button Grid.Column="2" Content="Làm mới" Height="38" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 2: ĐỐI SOÁT CHẤM CÔNG THỰC TẾ (ATTENDANCE AUDIT)         -->
            <!-- ============================================================ -->
            <TabItem Header=" Đối Soát Chấm Công Thực Tế ">
                <Border Margin="0,16,0,0"
                        Style="{StaticResource FlatCardBorderStyle}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Thanh bộ lọc -->
                            <RowDefinition Height="*"/>
                            <!-- DataGrid -->
                            <RowDefinition Height="Auto"/>
                            <!-- Footer tổng chi phí lương -->
                        </Grid.RowDefinitions>

                        <!-- Thanh bộ lọc đối soát -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Từ ngày:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpAuditFrom" Width="130" Height="34" Style="{StaticResource ModernDatePicker}" Margin="0,0,12,0"/>

                                <TextBlock Text="Đến ngày:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpAuditTo" Width="130" Height="34" Style="{StaticResource ModernDatePicker}" Margin="0,0,12,0"/>

                                <TextBlock Text="Nhân viên:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbAuditStaff" Width="160" Height="34" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,10,0">
                                    <ComboBoxItem Content="Tất cả nhân viên"/>
                                    <ComboBoxItem Content="Nguyễn Thu Ngân"/>
                                    <ComboBoxItem Content="Lê Pha Chế"/>
                                    <ComboBoxItem Content="Phạm Phục Vụ"/>
                                </ComboBox>

                                <Button Content="Lọc đối soát" Width="100" Height="34" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- DataGrid bảng chấm công toàn quán -->
                        <DataGrid Grid.Row="1"
                                  x:Name="DgAuditTable"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource FlatDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã NV" Binding="{Binding StaffCode}" Width="80"/>
                                <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StaffName}" Width="1.8*"/>
                                <DataGridTextColumn Header="Ngày Làm" Binding="{Binding Date}" Width="1.2*"/>
                                <DataGridTextColumn Header="Ca Phân Công" Binding="{Binding ShiftName}" Width="1.5*"/>
                                <DataGridTextColumn Header="Check-in" Binding="{Binding CheckInTime}" HeaderStyle="{StaticResource CenterColumnHeaderStyle}" ElementStyle="{StaticResource CenterCellTextStyle}" Width="1.1*"/>
                                <DataGridTextColumn Header="Check-out" Binding="{Binding CheckOutTime}" HeaderStyle="{StaticResource CenterColumnHeaderStyle}" ElementStyle="{StaticResource CenterCellTextStyle}" Width="1.1*"/>
                                <DataGridTextColumn Header="Số Giờ Làm" Binding="{Binding WorkHours}" HeaderStyle="{StaticResource CenterColumnHeaderStyle}" ElementStyle="{StaticResource CenterCellTextStyle}" Width="1.1*"/>
                                <DataGridTextColumn Header="Tiền Lương Ca" Binding="{Binding ShiftWage, StringFormat={}{0:N0}đ}" HeaderStyle="{StaticResource RightColumnHeaderStyle}" ElementStyle="{StaticResource RightCellTextStyle}" Width="1.4*"/>
                                <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Note}" Width="1.8*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Footer tổng chi phí lương -->
                        <Border Grid.Row="2"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrushDefault}"
                                BorderThickness="0,1,0,0"
                                Margin="-16,12,-16,-16"
                                Padding="16,10">
                            <DockPanel>
                                <TextBlock Text="Tổng chi phí tiền lương: 9.600.000đ"
                                           DockPanel.Dock="Right"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tổng số lượt làm việc: " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="48 ca" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,20,0"/>
                                    <TextBlock Text="Tổng giờ công toàn quán: " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="384.0 giờ" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
