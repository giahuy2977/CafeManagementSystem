<Window x:Class="CafeManagementSystem.Views.Dialogs.InvoiceDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CafeManagementSystem.Views.Dialogs"
        mc:Ignorable="d"
        Title="InvoiceDetailDialog" Height="460" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceCardBrush}"
        FontFamily="Be Vietnam Pro, Segoe UI">
    <Window.Resources>
        <!-- Style căn giữa cho cột Số lượng (Qty) -->
        <Style x:Key="CenterCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Style căn phải cho cột Đơn giá & Thành tiền -->
        <Style x:Key="RightCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Style căn phải cho tiêu đề cột Đơn giá & Thành tiền -->
        <Style x:Key="RightColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource FlatDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!-- Style căn giữa cho tiêu đề cột Số lượng -->
        <Style x:Key="CenterColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource FlatDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <!-- Header -->
            <RowDefinition Height="*"></RowDefinition>
            <!-- Table danh sách món -->
            <RowDefinition Height="auto"></RowDefinition>
            <!-- Cụm thông tin Tổng/GiảmGiá/ThanhToán -->
            <RowDefinition Height="auto"></RowDefinition>
            <!-- Nút tắt -->
        </Grid.RowDefinitions>

        <!-- ============================================================================== -->
        <!-- ROW 0 : HEADER DIALOG (Tiêu đề , mã hóa đơn, và thông tin thành công) -->
        <!-- ============================================================================== -->

        <Border Grid.Row="0" Padding="15"
                Background="{StaticResource SecondaryDarkBackground}">
            <DockPanel>

                <!-- Trạng thái hóa đơn -->
                <!-- Định nghĩa style riêng cho Badge trong phần MainStyle -->
                <Border Grid.Column="1" Style="{StaticResource OrderStatusBadgeBorderStyle}"
                        DockPanel.Dock="Right">
                    <TextBlock Style="{StaticResource OrderStatusBadgeTextStyle}" />
                </Border>

                <!-- Tiêu đề hóa đơn và mã hóa đơn -->
                <TextBlock Text="THÔNG TIN HÓA ĐƠN"
                           Foreground="{StaticResource TextOnDarkBrush}"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="15, 0, 0, 0"></TextBlock>

                <!-- Mã hóa đơn sau này có thể định nghĩa lại -->
                <TextBlock Text=" - #HD0012"
                           Foreground="{StaticResource TextOnDarkBrush}"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"></TextBlock>
            </DockPanel>
        </Border>

        <!-- ============================================================================== -->
        <!-- ROW 1 : BẢNG DANH SÁCH CÁC SẢN PHẨM CỦA HÓA ĐƠN -->
        <!-- ============================================================================== -->

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderBrushDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="20,20,20,16"
                ClipToBounds="True">

            <DataGrid ItemsSource="{Binding OrderDetails}"
                          Style="{StaticResource FlatDataGridStyle}">
                <DataGrid.Columns>
                    <!-- Cột 1: Tên món -->
                    <DataGridTextColumn Header="Sản phẩm"
                                        Binding="{Binding ProductName}"
                                        Width="1.8*" />

                    <!-- Cột 2: Số lượng -->
                    <DataGridTextColumn Header="Số lượng"
                                        Binding="{Binding Quantity}"
                                        HeaderStyle="{StaticResource CenterColumnHeaderStyle}"
                                        ElementStyle="{StaticResource CenterCellTextStyle}"
                                        Width="0.8*" />

                    <!-- Cột 3: Đơn giá lúc bán (UnitPrice lưu cứng theo D4) -->
                    <DataGridTextColumn Header="Đơn Giá"
                                        Binding="{Binding UnitPrice, StringFormat={}{0:N0}đ}"
                                        HeaderStyle="{StaticResource RightColumnHeaderStyle}"
                                        ElementStyle="{StaticResource RightCellTextStyle}"
                                        Width="1.2*" />

                    <!-- Cột 4: Thành tiền (LineTotal = Quantity * UnitPrice) -->
                    <DataGridTextColumn Header="Thành Tiền"
                                        Binding="{Binding LineTotal, StringFormat={}{0:N0}đ}"
                                        HeaderStyle="{StaticResource RightColumnHeaderStyle}"
                                        ElementStyle="{StaticResource RightCellTextStyle}"
                                        Width="1.2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============================================================================== -->
        <!-- ROW 2 : CỤM THÔNG TIN (TỔNG TIỀN, GIẢM GIÁ, THÀNH TIỀN) -->
        <!-- ============================================================================== -->

        <Grid Grid.Row="2"
              HorizontalAlignment="Right"
              Width="280"
              Margin="20,0,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Dòng 1: Tạm tính (Subtotal) -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Tạm tính : "
                       FontSize="14"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Right"
                       Margin="0,0,24,8" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding SubTotal, StringFormat={}{0:N0}đ, FallbackValue='273.000đ'}"
                       FontSize="14"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Right"
                       Margin="0,0,0,8" />

            <!-- Dòng 2: Giảm giá (Discount Amount) -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Giảm giá : "
                       FontSize="14"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Right"
                       Margin="0,0,24,8" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding DiscountAmount, StringFormat={}{0:N0}đ, FallbackValue='0đ'}"
                       FontSize="14"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Right"
                       Margin="0,0,0,8" />

            <!-- Dòng 3: Tổng thanh toán (Total Amount - Cỡ chữ 16 in đậm) -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Tổng cộng : "
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Right"
                       Margin="0,4,24,0" />
            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding TotalAmount, StringFormat={}{0:N0}đ, FallbackValue='273.000đ'}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Right"
                       Margin="0,4,0,0" />
        </Grid>
        
        <!-- ================================================================= -->
        <!-- ROW 3: NÚT ĐÓNG (CLOSE)                               -->
        <!-- ================================================================= -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrushDefault}"
                BorderThickness="0,1,0,0"
                Padding="5"
                >
            <Button Content="Đóng"
                    Width="120"
                    IsCancel="True"
                    Command="{Binding CloseDialogCommand}"
                    Click="CloseButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Center" />
        </Border>

    </Grid>
</Window>
