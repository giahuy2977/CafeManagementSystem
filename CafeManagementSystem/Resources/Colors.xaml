<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. Bảng màu chính (Kết hợp Staff Espresso & Admin Light Brown từ DESIGN.md) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4A2E1F" />
    <!-- StaffEspresso: Sidebar / Nút chính -->
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#33201A" />
    <!-- Dark Roast: Hover / Nhấn đậm -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#7A4B2F" />
    <!-- StaffWalnut: Nút phụ / Đang chọn -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8B5E3C" />
    <!-- Admin Light Brown: Điểm nhấn -->

    <!-- 2. Màu nền & Viền 1px (Flat Design - Không dùng Shadow) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1EAE3" />
    <!-- StaffLinen: Nền tổng thể -->
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF" />
    <!-- White: Nền Card / Panel -->
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F6F3EF" />
    <!-- AdminPaper: Nền phụ / Bảng xen kẽ -->
    <SolidColorBrush x:Key="BorderBrushDefault" Color="#D8C9BB" />
    <!-- StaffLine: Viền 1px -->
    <SolidColorBrush x:Key="TintBrush" Color="#E6D6C6" />
    <!-- StaffTint: Nền badge / Hàng chọn -->

    <!-- 3. Màu chữ (Đạt độ tương phản >= 4.5:1) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2B1B14" />
    <!-- StaffInk: Chữ chính -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6F5A4C" />
    <!-- StaffMuted: Chữ phụ -->
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF" />
    <!-- Chữ trắng trên nền tối -->

    <!-- 4. Cặp màu Trạng thái dùng chung (Chữ đậm trên nền nhạt - Mục 5 DESIGN.md) -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#2F5D3A" />
    <SolidColorBrush x:Key="StatusOkBgBrush" Color="#DDEBDD" />
    <!-- Completed / Available -->

    <SolidColorBrush x:Key="StatusWarnBrush" Color="#7A4A0C" />
    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="#F5E3C8" />
    <!-- Pending / Unpaid -->

    <SolidColorBrush x:Key="StatusInfoBrush" Color="#33506B" />
    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="#DCE6EE" />
    <!-- Thông tin xử lý -->

    <SolidColorBrush x:Key="StatusErrBrush" Color="#8F2C22" />
    <SolidColorBrush x:Key="StatusErrBgBrush" Color="#F3DAD5" />
    <!-- Cancelled / Lỗi / Xóa -->

    <!-- 5. Màu đặc thù cho Thẻ Bàn trên SalesView -->
    <SolidColorBrush x:Key="TableAvailableBrush" Color="#2F5D3A" />
    <!-- Bàn trống (Xanh trầm) -->
    <SolidColorBrush x:Key="TableOccupiedBrush" Color="#1A1A1A" />
    <!-- Bàn có khách (Đen Ink) -->
    
    <!--6. Màu đặc thù cho bộ icon Revenue-->
    <SolidColorBrush x:Key="IconPrimaryBrush" Color="#33201A" />
    <SolidColorBrush x:Key="IconSecondaryBrush" Color="#FFDAA520" />
</ResourceDictionary>