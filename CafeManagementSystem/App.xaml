             xmlns:local="clr-namespace:CafeManagementSystem"
             StartupUri="Views/UserControls/RevenueView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                
                <!-- Định nghĩa màu sắc chính cho chương trình -->
